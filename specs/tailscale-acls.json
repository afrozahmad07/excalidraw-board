{
  "title": "How Tailscale ACLs work",
  "out": "boards/tailscale-acls-library-icons.excalidraw",
  "panels": [
    {
      "head": "One file for the whole network",
      "layout": "hub",
      "caption": "Every access rule lives in a single tailnet policy file. A brand-new tailnet lets every device reach every other device.",
      "centre": {
        "shape": "doc",
        "size": 160,
        "marker": "tailnet policy file",
        "tint": "sky"
      },
      "items": [
        {
          "icon": [
            "net",
            "Computer (3D)"
          ],
          "label": "desktop",
          "wash": "mint"
        },
        {
          "icon": [
            "net",
            "Server"
          ],
          "label": "server",
          "wash": "peach"
        },
        {
          "icon": [
            "net",
            "Router"
          ],
          "label": "router",
          "wash": "lilac"
        },
        {
          "icon": [
            "net",
            "Switch"
          ],
          "label": "switch",
          "wash": "sky"
        }
      ],
      "footnote": "a new tailnet lets everyone reach everyone"
    },
    {
      "head": "Every rule is the same shape",
      "layout": "stack",
      "caption": "A rule names an action, sources and destinations. The action is always accept \u2014 there is no deny, because anything unmatched is denied already.",
      "rows": [
        {
          "label": "action",
          "wash": "mint",
          "marker": "accept",
          "tint": "mint"
        },
        {
          "label": "source",
          "wash": "lilac"
        },
        {
          "label": "destination",
          "wash": "sky"
        }
      ],
      "flow": [
        1,
        2
      ],
      "aside": {
        "shape": "padlock",
        "size": 96,
        "label": "everything else"
      },
      "footnote": "no rule matches, no traffic passes"
    },
    {
      "head": "Sources are named, not addressed",
      "layout": "grid",
      "cols": 3,
      "item_size": 120,
      "caption": "Rules point at users, groups, tags, autogroups, hosts and address ranges. Tagging a device removes its user account.",
      "items": [
        {
          "icon": [
            "people",
            "Stick man standard"
          ],
          "label": "user",
          "wash": "mint"
        },
        {
          "icon": [
            "people",
            "Stick woman standard"
          ],
          "label": "group",
          "wash": "lilac"
        },
        {
          "shape": "tag",
          "marker": "tag",
          "tint": "peach",
          "note": "a tag replaces the user"
        },
        {
          "shape": "ring",
          "label": "autogroup",
          "wash": "peach"
        },
        {
          "icon": [
            "net",
            "Server"
          ],
          "label": "host",
          "wash": "sky"
        },
        {
          "shape": "range",
          "label": "IP range"
        }
      ]
    },
    {
      "head": "Central policy, local enforcement",
      "layout": "row",
      "item_size": 100,
      "caption": "The coordination server compiles the policy into a packet filter and pushes it to every device. Each device filters its own incoming traffic.",
      "source": {
        "shape": "cloud",
        "size": 330,
        "label": "coordination server"
      },
      "items": [
        {
          "icon": [
            "net",
            "Computer (3D)"
          ],
          "label": "desktop",
          "wash": "mint"
        },
        {
          "icon": [
            "net",
            "Server"
          ],
          "label": "server",
          "wash": "lilac"
        },
        {
          "icon": [
            "net",
            "Switch"
          ],
          "label": "switch",
          "wash": "sky"
        }
      ],
      "gate": {
        "icon": [
          "net",
          "Firewall"
        ],
        "size": 60
      },
      "marker": "packet filter",
      "tint": "peach"
    },
    {
      "head": "Tests catch the lockout",
      "layout": "pair",
      "caption": "The policy file carries its own tests. They run on every save, so a rule that would cut you off fails before it ships.",
      "left": {
        "shape": "clipboard",
        "size": 240,
        "label": "policy tests"
      },
      "right": {
        "shape": "door",
        "size": 190,
        "marker": "save blocked",
        "tint": "rose"
      },
      "blocked": true,
      "footnote": "a failing test never reaches the tailnet"
    }
  ]
}